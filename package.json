{
  "name": "tree-sitter-email",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for RFC 5322 email / MIME messages (.eml), based on Vim's mail.vim and KDE's email.xml syntax definitions",
  "main": "bindings/node",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^7.0.0",
    "node-gyp-build": "^4.6.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.24.0"
  },
  "tree-sitter": [
    {
      "scope": "source.email",
      "file-types": ["eml", "email", "emlx", "mbox", "mbx"],
      "injection-regex": "^(eml|email|mime)$"
    }
  ]
}
